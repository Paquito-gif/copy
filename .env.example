# ===== Réseau =====
# Un RPC payant (Helius, Triton, QuickNode) est fortement conseillé en production
RPC_URL=https://mainnet.helius-rpc.com/?api-key=XXXX
WS_URL=wss://mainnet.helius-rpc.com/?api-key=XXXX

# ===== Wallet public du launchpad =====
# fee_receiver de TOUS les coins lancés + wallet de copy-trading. Dédié, publié sur le site.
FEE_RECEIVER=
# Clé privée de ce wallet : seulement pour le moteur (npm run start:engine), JAMAIS pour le serveur web.
BOT_PRIVATE_KEY=

# ===== Site =====
SITE_NAME=Copy Launch
PUBLIC_URL=https://ton-domaine.com
PORT=3000
DATA_DIR=./data

# ===== Copy-trading =====
# fomo = le moteur lit lui-même le n°1 du classement FOMO et le revérifie toutes les LEADER_SCAN_HOURS
# env  = liste fixe TRADERS ci-dessous
TRADER_SOURCE=fomo
LEADERBOARD_WINDOW=24h
LEADER_SCAN_HOURS=5
# API tierce du classement (fomo.family n'a pas d'API publique). Sans clé : top 10.
LEADERBOARD_URL=https://api.fomo-api.com/v1/leaderboard
FOMO_API_KEY=
# TOP1 = copie le n°1 | BASKET = copie les BASKET_SIZE premiers
MODE=TOP1
BASKET_SIZE=3
# Secours si TRADER_SOURCE=env (adresses séparées par des virgules)
TRADERS=

MAX_POSITION_PCT=8
MAX_OPEN_POSITIONS=6
MIN_TRADE_SOL=0.05
STOP_LOSS_PCT=35
TAKE_PROFIT_PCT=150
MAX_DAILY_LOSS_PCT=20
MAX_PRICE_IMPACT_PCT=3
SLIPPAGE_BPS=300
SOL_RESERVE=0.05

# ===== Buyback & burn =====
BUYBACK_PCT=80
MIN_BUYBACK_SOL=0.1
MIN_BUYBACK_PER_COIN_SOL=0.01

CONVERT_INTERVAL_MIN=60
MONITOR_INTERVAL_SEC=30

# true = le moteur simule (aucune transaction). Le site, lui, lance de vrais coins.
DRY_RUN=true

# Affichage sur le site (optionnel ; en mode fomo le pseudo vient du classement)
TRADER_LABEL=
TRADER_URL=
